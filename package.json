{
  "name": "extrapolar",
  "private": true,
  "version": "0.1.0",
  "description": "Extrapolar — o que os deputados federais estão fazendo na Câmara, em números e fatos, sem julgamento.",
  "author": "Lucas Barreto <lucasbrsantana@gmail.com>",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@extrapolar/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pipeline": "pnpm --filter @extrapolar/pipeline start",
    "check:neutralidade": "node scripts/check-neutrality.mjs",
    "check:a11y": "node scripts/a11y.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "repo-growth": "node scripts/repo-growth.mjs",
    "check:a11y:jogos": "node scripts/a11y-jogos.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "unpdf": "1.8.1"
  }
}
