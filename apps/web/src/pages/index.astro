---
// Capa: manchete com o número de deputados e a lista com busca e filtros por estado e partido.
// A lista é sempre em ordem alfabética: o site não ordena deputados por nenhum indicador.
import BaseLayout from "../layouts/BaseLayout.astro";
import BigNumber from "../components/ui/BigNumber.astro";
import Headline from "../components/ui/Headline.astro";
import Rule from "../components/ui/Rule.astro";
import DeputyFilters from "../components/deputado/DeputyFilters.astro";
import DeputyRow from "../components/deputado/DeputyRow.astro";
import { repository } from "../lib/data";
import { formatInteger, formatLongDate } from "../lib/format";

const summary = await repository.getParticipationSummary();
const deputies = await repository.listDeputies();
const collator = new Intl.Collator("pt-BR");
const states = [...new Set(deputies.map((d) => d.state))].sort(collator.compare);
const parties = [...new Set(deputies.map((d) => d.party))].sort(collator.compare);
---

<BaseLayout current="deputados">
  <section class="grid gap-8 lg:grid-cols-[2fr_1fr] lg:gap-0">
    <div class="lg:border-r lg:border-rule lg:pr-8">
      <p class="kicker m-0">Câmara dos Deputados</p>
      <Headline as="h1" size="xl" class="mt-2">
        {formatInteger(deputies.length)} deputados em exercício.{" "}
        <span class="marker">Veja o que cada um</span> fez no plenário.
      </Headline>
      <p class="mt-4 max-w-prose text-lg">
        Escolha um nome para ver os dados oficiais dessa pessoa, explicados em poucas linhas. Sem
        ranking e sem adjetivo: você olha o dado e tira suas conclusões.
      </p>
    </div>
    <div class="lg:pl-8">
      <BigNumber
        value={formatInteger(summary.nominalPlenaryVotes)}
        label="Votações nominais no plenário"
        caption={`Votações em que cada voto fica registrado com o nome do deputado. Desde 1º de fevereiro de 2023 até ${summary.lastVoteDate ? formatLongDate(summary.lastVoteDate) : "hoje"}.`}
        updatedAt={summary.referenceDateTime}
        methodologyAnchor="participacao"
      />
    </div>
  </section>

  <Rule variant="thick" class="mt-10" />

  <section aria-labelledby="lista-deputados" class="pt-4">
    <Headline as="h2" size="lg" id="lista-deputados">
      Os deputados
    </Headline>
    <div class="mt-4">
      <DeputyFilters states={states} parties={parties} total={deputies.length} />
    </div>
    <ul
      class="mt-4 grid list-none grid-cols-1 gap-x-8 p-0 sm:grid-cols-2 lg:grid-cols-3"
      aria-label="Lista de deputados"
    >
      {deputies.map((deputy) => (
        <DeputyRow deputy={deputy} />
      ))}
    </ul>
  </section>
</BaseLayout>
