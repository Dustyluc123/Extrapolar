---
// Páginas só de desenvolvimento: existem em `pnpm dev` e não são geradas no build (getStaticPaths
// devolve lista vazia fora do dev). Hoje só /dev/resumos: revisão dos resumos em linguagem simples
// das votações dos jogos, com a ementa oficial ao lado do rascunho. Os arquivos são lidos a cada
// recarga, então dá para editar o .md e recarregar.
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { parseSummaryFile, glossarySlugs, type PlainSummary } from "@extrapolar/shared";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SummaryText } from "../../components/games/SummaryText";
import { GLOSSARY } from "../../lib/glossary";
import { formatShortDate } from "../../lib/format";
import { gameVotesInUse, SUMMARIES_DIR, ROOT } from "../../../../../scripts/lib/resumos.mjs";
import { judgmentWords } from "../../../../../scripts/lib/neutrality-words.mjs";

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { pagina: "resumos" } }] : [];
}

interface UsedVote {
  id: string;
  date: string;
  proposition: { id: number; label: string; summary: string };
  object: string;
  turn: string | null;
  approved: boolean;
  official: { yes: number; no: number; others: number };
  games: string[];
}

type Row = UsedVote & {
  file: string;
  summary: PlainSummary | null;
  error: string | null;
  unknownSlugs: string[];
  flagged: string[];
};

const slugs = new Set(GLOSSARY.map((g) => g.slug));
const votes = (await gameVotesInUse()) as UsedVote[];
const rows: Row[] = [];
for (const vote of votes) {
  const file = join(SUMMARIES_DIR, `${vote.id}.md`);
  let summary: PlainSummary | null = null;
  let error: string | null = null;
  try {
    summary = parseSummaryFile(vote.id, await readFile(file, "utf8"));
  } catch (e) {
    const err = e as Error & { code?: string };
    if (err.code !== "ENOENT") error = err.message;
  }
  const texts = summary ? `${summary.text} ${summary.curiosity ?? ""}` : "";
  rows.push({
    ...vote,
    file: file.replace(ROOT, ""),
    summary,
    error,
    unknownSlugs: glossarySlugs(texts).filter((s) => !slugs.has(s)),
    flagged: (judgmentWords(texts) as string[]).filter((w, i, all) => all.indexOf(w) === i),
  });
}
const drafts = rows.filter((r) => r.error || (r.summary && !r.summary.reviewed));
const missing = rows.filter((r) => !r.error && !r.summary);
const reviewed = rows.filter((r) => r.summary?.reviewed);
---

<BaseLayout title="Revisão dos resumos (dev)" description="Página só de desenvolvimento.">
  <p class="kicker m-0">Só em pnpm dev · não vai para o site</p>
  <h1 class="m-0 mt-1 font-display text-3xl font-[750]">Revisão dos resumos</h1>
  <p class="m-0 mt-2">
    {votes.length} votações usadas pelos jogos: <strong>{drafts.length} rascunhos</strong> para
    revisar, {missing.length} sem arquivo e {reviewed.length} revisadas. Para aprovar, confira o
    texto oficial, apague a seção "Dúvidas" (se houver) e troque <code>revisado: false</code> por{" "}
    <code>revisado: true</code> no arquivo, com o seu nome em <code>autor</code>. Edite o .md e
    recarregue esta página.
  </p>

  <ol class="mt-6 list-none p-0">
    {drafts.map((row) => (
      <li class="border-t border-rule py-5" id={row.id}>
        <p class="kicker m-0">
          {formatShortDate(row.date)} · {row.proposition.label}
          {row.turn ? ` · ${row.turn} turno` : ""} · {row.object} ·{" "}
          {row.approved ? "aprovada" : "rejeitada"} ({row.official.yes} × {row.official.no}) ·{" "}
          {row.games.join(", ")}
        </p>
        <p class="caption m-0 mt-1">
          <code>{row.file}</code> ·{" "}
          <a href={`https://www.camara.leg.br/propostas-legislativas/${row.proposition.id}`}>
            proposição na Câmara
          </a>
          {row.summary?.source ? (
            <>
              {" "}
              · <a href={row.summary.source}>texto oficial usado</a>
            </>
          ) : null}
        </p>
        {row.error ? (
          <p class="m-0 mt-2 font-sans text-sm">⚠ Arquivo inválido: {row.error}</p>
        ) : null}
        <div class="mt-3 grid gap-4 md:grid-cols-2">
          <div>
            <p class="kicker m-0">Ementa oficial</p>
            <p class="m-0 mt-1">{row.proposition.summary}</p>
          </div>
          {row.summary ? (
            <div>
              <p class="kicker m-0">O que estava em votação</p>
              <p class="m-0 mt-1">
                <SummaryText text={row.summary.text} />
              </p>
              {row.summary.curiosity ? (
                <>
                  <p class="kicker m-0 mt-3">Curiosidade</p>
                  <p class="m-0 mt-1">
                    <SummaryText text={row.summary.curiosity} />
                  </p>
                </>
              ) : null}
              {row.summary.doubts ? (
                <div class="mt-3 border-l-4 border-accent pl-3">
                  <p class="kicker m-0">Dúvidas (não vão para o site)</p>
                  <p class="m-0 mt-1 whitespace-pre-line font-sans text-sm">{row.summary.doubts}</p>
                </div>
              ) : null}
              {row.unknownSlugs.length > 0 ? (
                <p class="m-0 mt-2 font-sans text-sm">
                  ⚠ Termo fora do glossário (quebra o build quando revisado):{" "}
                  {row.unknownSlugs.join(", ")}
                </p>
              ) : null}
              {row.flagged.length > 0 ? (
                <p class="m-0 mt-2 font-sans text-sm">
                  ⚠ Palavra da lista de neutralidade: {row.flagged.join(", ")}
                </p>
              ) : null}
            </div>
          ) : null}
        </div>
      </li>
    ))}
  </ol>

  {missing.length > 0 ? (
    <section class="mt-8">
      <h2 class="m-0 font-display text-xl">Sem arquivo de resumo ({missing.length})</h2>
      <p class="caption m-0 mt-1">Rode /resumos no Claude Code para criar os rascunhos.</p>
      <ul class="mt-2">
        {missing.map((row) => (
          <li>
            {row.id} · {row.proposition.label}
            {row.turn ? ` (${row.turn} turno)` : ""} · {row.games.join(", ")}
          </li>
        ))}
      </ul>
    </section>
  ) : null}
</BaseLayout>
