---
// Ficha do deputado: identidade e os cadernos de métricas (Plenário, Comissões, ...),
// cada métrica com fonte, data de atualização e link para a metodologia.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import Headline from "../../components/ui/Headline.astro";
import Rule from "../../components/ui/Rule.astro";
import Term from "../../components/ui/Term.astro";
import DeputyPhoto from "../../components/deputado/DeputyPhoto.astro";
import ParticipationSection from "../../components/deputado/ParticipationSection.astro";
import PresenceSection from "../../components/deputado/PresenceSection.astro";
import AlignmentSection from "../../components/deputado/AlignmentSection.astro";
import CommitteesSection from "../../components/deputado/CommitteesSection.astro";
import CommitteePresenceSection from "../../components/deputado/CommitteePresenceSection.astro";
import RequestedEventsSection from "../../components/deputado/RequestedEventsSection.astro";
import PropositionsSection from "../../components/deputado/PropositionsSection.astro";
import SituationSection from "../../components/deputado/SituationSection.astro";
import ThemesSection from "../../components/deputado/ThemesSection.astro";
import OpinionsSection from "../../components/deputado/OpinionsSection.astro";
import Caderno from "../../components/ficha/Caderno.astro";
import CadernoNav from "../../components/ficha/CadernoNav.astro";
import { repository } from "../../lib/data";
import { formatDateTime } from "../../lib/format";
import { stateName } from "../../lib/states";

export async function getStaticPaths() {
  const deputies = await repository.listDeputies();
  return deputies.map((deputy) => ({ params: { id: String(deputy.id) } }));
}

const id = Number(Astro.params.id);
const profile = await repository.getDeputy(id);
if (!profile) throw new Error(`Deputado ${id} não encontrado nos dados gerados.`);
const { deputy, detail } = profile;
const meta = await repository.getMeta();
const updatedAt = meta.referenceDateTime;

const cadernos = [
  { id: "plenario", label: "Plenário" },
  { id: "caderno-comissoes", label: "Comissões" },
  { id: "caderno-projetos", label: "Projetos e leis" },
];
const conditionSlug =
  deputy.electoralCondition === "Titular"
    ? "titular"
    : deputy.electoralCondition
      ? "suplente"
      : null;
---

<BaseLayout
  title={deputy.name}
  description={`${deputy.name} (${deputy.party}-${deputy.state}): dados oficiais da Câmara dos Deputados, com fonte e metodologia.`}
  current="deputados"
>
  <p class="m-0 font-sans text-sm">
    <a href="/" class="no-underline hover:underline">
      ← Todos os deputados
    </a>
  </p>

  <article class="mt-5">
    <header class="flex flex-col gap-5 sm:flex-row sm:items-end sm:gap-8">
      <DeputyPhoto src={deputy.photoUrl} name={deputy.name} size="lg" eager />
      <div class="min-w-0">
        <p class="kicker m-0">Câmara dos Deputados · {stateName(deputy.state)}</p>
        <Headline as="h1" size="xl" class="mt-1 break-words">
          {deputy.name}
        </Headline>
        <p class="mt-3 mb-0 flex flex-wrap gap-2">
          <Badge label={deputy.party} title={`Partido: ${deputy.party}`} />
          <Badge label={deputy.state} title={`Estado: ${stateName(deputy.state)}`} />
        </p>
      </div>
    </header>

    <Rule class="mt-6" />

    <dl class="m-0 grid gap-x-8 gap-y-3 py-4 font-sans text-sm sm:grid-cols-3">
      <div>
        <dt class="kicker">Situação</dt>
        <dd class="m-0 mt-0.5">
          <Term slug="em-exercicio">{deputy.status}</Term>
          {deputy.inServiceSince ? ` desde ${formatDateTime(deputy.inServiceSince)}` : null}
        </dd>
      </div>
      <div>
        <dt class="kicker">Condição</dt>
        <dd class="m-0 mt-0.5">
          {conditionSlug ? (
            <Term slug={conditionSlug}>{deputy.electoralCondition}</Term>
          ) : (
            "Sem dado"
          )}
        </dd>
      </div>
      <div>
        <dt class="kicker">Página oficial</dt>
        <dd class="m-0 mt-0.5">
          <a href={deputy.profileUrl} rel="external">
            camara.leg.br
          </a>
        </dd>
      </div>
    </dl>

    <CadernoNav items={cadernos} />

    <Caderno
      id="plenario"
      number={1}
      title="Plenário"
      intro="O que acontece na sala onde todos os 513 deputados votam."
    >
      <ParticipationSection participation={detail.plenario.participacao} updatedAt={updatedAt} />
      <PresenceSection attendance={detail.plenario.presencaSessoes} updatedAt={updatedAt} />
      <AlignmentSection
        kind="partido"
        alignment={detail.plenario.alinhamentoPartido}
        updatedAt={updatedAt}
      />
      <AlignmentSection
        kind="governo"
        alignment={detail.plenario.alinhamentoGoverno}
        updatedAt={updatedAt}
      />
    </Caderno>

    <Caderno
      id="caderno-comissoes"
      number={2}
      title="Comissões"
      intro="Os grupos menores onde as propostas são estudadas, debatidas e muitas vezes decididas."
    >
      <CommitteesSection
        comissoes={detail.comissoes}
        legislatureStart={meta.legislature.start}
        updatedAt={updatedAt}
      />
      <CommitteePresenceSection comissoes={detail.comissoes} updatedAt={updatedAt} />
      <RequestedEventsSection comissoes={detail.comissoes} updatedAt={updatedAt} />
    </Caderno>

    <Caderno
      id="caderno-projetos"
      number={3}
      title="Projetos e leis"
      intro="As propostas que o deputado apresentou, o que aconteceu com elas e os pareceres que escreveu."
    >
      <PropositionsSection projetos={detail.projetos} updatedAt={updatedAt} />
      <SituationSection projetos={detail.projetos} updatedAt={updatedAt} />
      <ThemesSection projetos={detail.projetos} updatedAt={updatedAt} />
      <OpinionsSection projetos={detail.projetos} updatedAt={updatedAt} />
    </Caderno>

    <p class="caption mt-10">Foto: Câmara dos Deputados.</p>
  </article>
</BaseLayout>
