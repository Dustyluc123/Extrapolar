---
// "Resumo em números": 6 números fixos, os mesmos para todos os deputados (decidido no plano da
// Fase 1, para não parecer destaque editorial). Cada um leva à métrica completa na ficha.
import type { DeputyDetail } from "@extrapolar/shared";
import { formatBRLCompact, formatInteger, formatPercent } from "../../lib/format";

interface Props {
  detail: DeputyDetail;
}
const { detail: d } = Astro.props;
const items = [
  {
    label: "Votou em",
    value:
      d.plenario.participacao.rate === null ? null : formatPercent(d.plenario.participacao.rate),
    note: "das votações nominais",
    href: "#participacao",
  },
  {
    label: "Presente em",
    value:
      d.plenario.presencaSessoes.rate === null
        ? null
        : formatPercent(d.plenario.presencaSessoes.rate),
    note: "das sessões deliberativas",
    href: "#presenca-sessoes",
  },
  {
    label: "Projetos",
    value: formatInteger(d.projetos.autorPrincipal),
    note: "como autor principal",
    href: "#proposicoes",
  },
  {
    label: "Pedidos de informação",
    value: formatInteger(d.fiscalizacao.ric.autorPrincipal),
    note: "ao governo (RIC)",
    href: "#ric",
  },
  {
    label: "Comissões",
    value: formatInteger(d.comissoes.titularHoje),
    note: "como titular hoje",
    href: "#comissoes",
  },
  {
    label: "Cota parlamentar",
    value: formatBRLCompact(d.dinheiro.cota.total),
    note: "gasta na legislatura",
    href: "#cota",
  },
];
---

<section aria-labelledby="resumo-titulo" class="mt-8">
  <div class="flex items-center gap-3">
    <h2 id="resumo-titulo" class="kicker m-0">
      Resumo em números
    </h2>
    <span class="stamp" aria-hidden="true">
      Dado oficial
    </span>
  </div>
  <ul class="mt-3 grid list-none grid-cols-2 gap-3 p-0 sm:grid-cols-3">
    {items.map((item, index) => (
      <li>
        <a
          href={item.href}
          class:list={["clipping block h-full no-underline", index % 2 === 0 ? "tilt-l" : "tilt-r"]}
        >
          <span class="kicker block">{item.label}</span>
          <span class="count-up mt-1 block font-display text-3xl leading-none font-[800] tabular-nums sm:text-4xl">
            {item.value ?? "Sem dado"}
          </span>
          <span class="caption mt-1 block">{item.note}</span>
          <span class="mt-2 block font-sans text-xs font-semibold text-accent-ink">
            Ver detalhes →
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
