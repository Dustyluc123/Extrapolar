---
// Métrica: participação em votações nominais de plenário (Caderno 1 — Plenário).
// Mesma apresentação para todos os deputados (sem cor de "bom" ou "ruim").
import type { Participation } from "@extrapolar/shared";
import BigNumber from "../ui/BigNumber.astro";
import Term from "../ui/Term.astro";
import Metric from "../ficha/Metric.astro";
import NoData from "../ficha/NoData.astro";
import { formatDateTime, formatInteger, formatPercent, plural } from "../../lib/format";

interface Props {
  participation: Participation;
  updatedAt: string;
}
const { participation: p, updatedAt } = Astro.props;

/** Abaixo disso, a ficha avisa que a porcentagem pode mudar muito (docs/METODOLOGIA.md). */
const FEW_VOTES = 30;

const missing = p.eligibleVotes - p.ballotsCast;
const rows = [
  { label: "Sim", value: p.breakdown.yes },
  { label: "Não", value: p.breakdown.no },
  { label: "Abstenção", value: p.breakdown.abstention },
  { label: "Obstrução", value: p.breakdown.obstruction },
  { label: "Artigo 17 (presidindo a sessão)", value: p.breakdown.article17 },
  { label: "Voto secreto", value: p.breakdown.secret },
];
const castShare = p.eligibleVotes > 0 ? (p.ballotsCast / p.eligibleVotes) * 100 : 0;
---

<Metric
  plain="quando a votação é “com nome”, teve voto registrado?"
  id="participacao"
  title="Participação em votações nominais"
  whatIs="Mostra em quantas votações do plenário com voto registrado no nome o deputado votou, contando só os dias em que estava no cargo."
  updatedAt={updatedAt}
  methodologyAnchor="participacao"
>
  {p.rate !== null ? (
    <div class="grid gap-8 lg:grid-cols-2">
      <div>
        <BigNumber
          value={formatPercent(p.rate)}
          label="Votou em"
          caption={`Registrou voto em ${formatInteger(p.ballotsCast)} das ${plural(p.eligibleVotes, "votação nominal", "votações nominais")} do plenário que aconteceram enquanto estava em exercício na legislatura.`}
        />
        <div class="mt-6" aria-hidden="true">
          <div class="flex h-3 overflow-hidden rounded-full border border-ink/70">
            <div class="bar-grow h-full bg-ink" style={`width: ${castShare.toFixed(2)}%`} />
            <div
              class="h-full flex-1"
              style="background-image: repeating-linear-gradient(135deg, var(--color-rule) 0 1px, transparent 1px 6px);"
            />
          </div>
          <div class="mt-1.5 flex justify-between font-sans text-xs text-ink-soft">
            <span>Com voto registrado</span>
            <span>Sem voto registrado</span>
          </div>
        </div>
        {p.eligibleVotes < FEW_VOTES ? (
          <p class="mt-4 rounded-card border border-rule bg-card p-3 font-sans text-sm">
            Poucas votações na conta ({formatInteger(p.eligibleVotes)}): com tão poucas, a
            porcentagem pode mudar bastante a cada nova votação.
          </p>
        ) : null}
      </div>

      <div>
        <table class="w-full border-collapse font-sans text-sm">
          <caption class="kicker mb-2 text-left">Como foram os votos registrados</caption>
          <thead class="sr-only">
            <tr>
              <th scope="col">Tipo</th>
              <th scope="col">Votações</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr class="border-b border-rule/70">
                <th scope="row" class="py-1.5 text-left font-normal">
                  {row.label}
                </th>
                <td class="py-1.5 text-right tabular-nums">{formatInteger(row.value)}</td>
              </tr>
            ))}
            <tr class="border-b-2 border-ink">
              <th scope="row" class="py-1.5 text-left font-semibold">
                Total com voto registrado
              </th>
              <td class="py-1.5 text-right font-semibold tabular-nums">
                {formatInteger(p.ballotsCast)}
              </td>
            </tr>
            <tr>
              <th scope="row" class="py-1.5 text-left font-normal">
                Sem voto registrado
              </th>
              <td class="py-1.5 text-right tabular-nums">{formatInteger(missing)}</td>
            </tr>
          </tbody>
        </table>
        <p class="caption mt-3">
          <Term slug="obstrucao" /> e voto secreto contam como participação: o deputado registrou
          presença na votação. "<Term slug="artigo-17" />" é registrado para quem está presidindo a
          sessão.
        </p>
      </div>
    </div>
  ) : (
    <NoData reason="sem-votacao-elegivel" label="Votou em" />
  )}

  {p.servicePeriods.length > 0 ? (
    <div class="mt-6">
      <p class="kicker m-0">
        Períodos <Term slug="em-exercicio" /> nesta legislatura
      </p>
      <ul class="mt-2 mb-0 list-none space-y-1 p-0 font-sans text-sm text-ink-soft">
        {p.servicePeriods.map((period) => (
          <li>
            De {formatDateTime(period.start)}{" "}
            {period.end ? `até ${formatDateTime(period.end)}` : "até hoje"}
          </li>
        ))}
      </ul>
      {p.ballotsOutsideServicePeriods > 0 ? (
        <p class="caption mt-2">
          {plural(p.ballotsOutsideServicePeriods, "voto foi registrado", "votos foram registrados")}{" "}
          fora desses períodos (diferença de horário nos registros da Câmara) e{" "}
          {p.ballotsOutsideServicePeriods === 1 ? "foi contado" : "foram contados"} mesmo assim.
        </p>
      ) : null}
    </div>
  ) : null}

  <Fragment slot="limites">
    <li>Trabalho em comissões, relatorias, projetos apresentados e atuação no estado.</li>
    <li>
      <Term slug="votacao-simbolica">Votações simbólicas</Term>, em que ninguém tem voto registrado.
    </li>
    <li>Como o deputado votou em cada tema, só se registrou voto.</li>
    <li>O motivo de uma ausência (missão oficial, doença, compromisso no estado).</li>
  </Fragment>
</Metric>
