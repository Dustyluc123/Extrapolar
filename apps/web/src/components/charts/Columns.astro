---
// Colunas para séries no tempo (mês, trimestre, ano). SVG estático gerado no build (ADR 0013):
// posições horizontais em %, para o gráfico se ajustar à largura sem encolher o texto.
import ChartFigure from "./ChartFigure.astro";

export interface ColumnItem {
  /** Rótulo completo (tabela e leitores de tela), ex.: "março de 2024". */
  label: string;
  /** Rótulo curto no eixo; vazio = sem rótulo nesta coluna. */
  tick: string;
  value: number;
  display: string;
  highlight?: boolean;
}

interface Props {
  title: string;
  description: string;
  items: ColumnItem[];
  /** Texto da escala no topo (ex.: "máximo: R$ 52 mil"). */
  maxLabel: string;
  labelHeader?: string;
  valueHeader?: string;
}
const {
  title,
  description,
  items,
  maxLabel,
  labelHeader = "Período",
  valueHeader = "Valor",
} = Astro.props;

const HEIGHT = 180;
const TOP = 22;
const BASE = 148;
const max = Math.max(0, ...items.map((item) => item.value));
const step = items.length > 0 ? 100 / items.length : 100;
const barWidth = step * (items.length > 24 ? 0.66 : 0.72);
const barHeight = (value: number) => (max > 0 ? (Math.max(0, value) / max) * (BASE - TOP) : 0);
const pct = (value: number) => `${value.toFixed(3)}%`;
---

<ChartFigure
  title={title}
  description={description}
  table={{
    headers: [labelHeader, valueHeader],
    rows: items.map((item) => [item.label, item.display]),
  }}
>
  <svg width="100%" height={HEIGHT} aria-hidden="true" class="block overflow-visible">
    <line x1="0" x2="100%" y1={TOP} y2={TOP} class="stroke-rule" stroke-dasharray="2 3" />
    <text x="0" y={TOP - 7} class="fill-ink-soft font-sans text-[11px]">
      {maxLabel}
    </text>
    <line x1="0" x2="100%" y1={BASE} y2={BASE} class="stroke-ink" />
    {items.map((item, index) => {
      const h = barHeight(item.value);
      return (
        <rect
          x={pct(index * step + (step - barWidth) / 2)}
          y={BASE - h}
          width={pct(barWidth)}
          height={h}
          class:list={["column-grow", item.highlight ? "fill-accent" : "fill-ink"]}
        />
      );
    })}
    {items.map((item, index) =>
      item.tick ? (
        <text
          x={pct(index * step + step / 2)}
          y={BASE + 18}
          text-anchor="middle"
          class="fill-ink-soft font-sans text-[11px]"
        >
          {item.tick}
        </text>
      ) : null,
    )}
  </svg>
</ChartFigure>
