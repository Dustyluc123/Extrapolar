---
// Moldura de todo gráfico: título, descrição em texto e tabela com os mesmos dados (recolhida).
// Gráficos são estáticos, gerados no build (ADR 0013).
interface Props {
  title: string;
  description: string;
  table: { headers: [string, string]; rows: [string, string][] };
}
const { title, description, table } = Astro.props;
---

<figure class="m-0">
  <figcaption>
    <p class="kicker m-0">{title}</p>
    <p class="caption mt-1 mb-3">{description}</p>
  </figcaption>
  <slot />
  <details class="mt-3">
    <summary class="cursor-pointer font-sans text-xs font-semibold text-ink-soft">
      Ver os dados em tabela
    </summary>
    <table class="mt-2 w-full border-collapse font-sans text-sm">
      <thead>
        <tr class="border-b border-ink">
          <th scope="col" class="py-1 text-left font-semibold">
            {table.headers[0]}
          </th>
          <th scope="col" class="py-1 text-right font-semibold">
            {table.headers[1]}
          </th>
        </tr>
      </thead>
      <tbody>
        {table.rows.map(([label, value]) => (
          <tr class="border-b border-rule/60">
            <th scope="row" class="py-1 text-left font-normal">
              {label}
            </th>
            <td class="py-1 text-right tabular-nums">{value}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>
