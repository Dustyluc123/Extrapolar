---
// Linha de verificação que acompanha todo número: fonte, data de atualização e metodologia.
import { SOURCE_NAME, CAMARA_PORTAL_URL } from "@extrapolar/shared";
import { formatDateTime } from "../../lib/format";

interface Props {
  updatedAt: string;
  methodologyAnchor: string;
  sourceName?: string;
  sourceUrl?: string;
}
const {
  updatedAt,
  methodologyAnchor,
  sourceName = SOURCE_NAME,
  sourceUrl = CAMARA_PORTAL_URL,
} = Astro.props;
---

<p class="m-0 font-sans text-xs leading-relaxed text-ink-soft">
  Fonte:{" "}
  <a href={sourceUrl} class="underline">
    {sourceName}
  </a>
  <span aria-hidden="true"> · </span>
  Atualizado em {formatDateTime(updatedAt)}
  <span aria-hidden="true"> · </span>
  <a href={`/metodologia#${methodologyAnchor}`} class="font-semibold text-accent-ink underline">
    Como calculamos
  </a>
</p>
