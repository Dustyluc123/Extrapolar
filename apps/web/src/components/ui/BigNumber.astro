---
// Número tratado como manchete, com legenda em itálico. A linha de fonte fica no bloco da
// métrica (ficha) ou é passada aqui (capa) via updatedAt + methodologyAnchor.
import SourceNote from "./SourceNote.astro";

interface Props {
  value: string;
  label: string;
  caption?: string;
  updatedAt?: string;
  methodologyAnchor?: string;
}
const { value, label, caption, updatedAt, methodologyAnchor } = Astro.props;
---

<figure class="m-0">
  <p class="kicker m-0">{label}</p>
  <p
    class="count-up m-0 font-display text-[4rem] leading-none font-[800] tracking-[-0.03em] text-ink tabular-nums sm:text-8xl"
    style="font-variation-settings: 'SOFT' 50, 'WONK' 1;"
  >
    {value}
  </p>
  {caption ? <figcaption class="caption mt-2 max-w-prose">{caption}</figcaption> : null}
  {updatedAt && methodologyAnchor ? (
    <div class="mt-3">
      <SourceNote updatedAt={updatedAt} methodologyAnchor={methodologyAnchor} />
    </div>
  ) : null}
</figure>
